@model BookShelf.Data.Models.Book

@{
    var imagePath = "/images/default-book.png";
}

<div class="col-sm-6 col-md-4 col-lg-3">
    <div class="card h-100 shadow-sm">
        <img src="@(Model.ImageUrl ?? @imagePath)" class="card-img-top" alt="@Model.Title" style="height: 200px; object-fit: cover;">

        <div class="card-body d-flex flex-column">
            <h5 class="card-title mb-1">"@Model.Title"</h5>
            <div class="text-muted mt-auto">
                Year: @Model.Year • Author: @(Model.Author.Name ?? "Unknown")
            </div>
        </div>
    </div>
</div>
