@using CookBookApp.Data.Enums
@using CookBookApp.Web.ViewModels.Recipe

@model RecipeInputViewModel

@{
	ViewData["Title"] = $"Edit {Model.Name}";
}

<h1 class="mb-4">Edit Recipe</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
	<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

	<input type="hidden" asp-for="Id" />

	<div class="row g-3">
		<div class="col-md-8">
			<label asp-for="Name" class="form-label"></label>
			<input asp-for="Name" class="form-control" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>

		<div class="col-md-4">
			<label asp-for="CategoryId" class="form-label">Category</label>
			<select asp-for="CategoryId"
					asp-items="@(new SelectList(Model.CategoryDropDown, "Id", "Name"))"
					class="form-select">
			</select>
			<span asp-validation-for="CategoryId" class="text-danger"></span>
		</div>

		<div class="col-md-4">
			<label asp-for="PrepTime" class="form-label">Prep time (min)</label>
			<input asp-for="PrepTime" class="form-control" />
			<span asp-validation-for="PrepTime" class="text-danger"></span>
		</div>

		<div class="col-md-4">
			<label asp-for="CookTime" class="form-label">Cook time (min)</label>
			<input asp-for="CookTime" class="form-control" />
			<span asp-validation-for="CookTime" class="text-danger"></span>
		</div>

		<div class="col-md-4">
			<label asp-for="Servings" class="form-label"></label>
			<input asp-for="Servings" class="form-control" />
			<span asp-validation-for="Servings" class="text-danger"></span>
		</div>

		<div class="col-12">
			<label asp-for="ImageUrl" class="form-label">Image URL</label>
			<input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
			<span asp-validation-for="ImageUrl" class="text-danger"></span>
		</div>

		<div class="col-12">
			<label asp-for="Instructions" class="form-label"></label>
			<textarea asp-for="Instructions" class="form-control" rows="8"></textarea>
			<span asp-validation-for="Instructions" class="text-danger"></span>
		</div>
	</div>

	<div class="mt-4 d-flex gap-2">
		<button type="submit" class="btn btn-primary">Save</button>
		<a asp-action="Index" class="btn btn-secondary">Cancel</a>
	</div>
</form>

<div class="card mt-5">
	<div class="card-header">
		<h2 class="h5 mb-0">Ingredients</h2>
	</div>

	<div class="table-responsive">
		<table class="table align-middle mb-0">
			<thead>
				<tr>
					<th>Ingredient</th>
					<th>Quantity</th>
					<th>Unit</th>
					<th>Note</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var ingredient in Model.Ingredients)
				{
					<tr>
						<td>@ingredient.Name</td>
						<td>@ingredient.Quantity</td>
						<td>@ingredient.MeasurementUnit</td>
						<td>@ingredient.Note</td>
						<td class="text-end">
							<form asp-action="RemoveRow" method="post">
								<input type="hidden" name="recipeId" value="@Model.Id" />
								<input type="hidden" name="ingredientId" value="@ingredient.Id" />
								<button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
							</form>
						</td>
					</tr>
				}

				@if (!Model.Ingredients.Any())
				{
					<tr>
						<td colspan="5" class="text-center text-muted">No ingredients yet.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="card-body border-top">
		<form asp-action="AddRow" method="post">
			<input type="hidden" name="recipeId" value="@Model.Id" />

			<div class="row g-2 align-items-start">
				<div class="col-md-3">
					<select asp-for="NewIngredient.Id"
							asp-items="@(new SelectList(Model.IngredientDropDowns, "Id", "Name"))"
							class="form-select">
					</select>
					<span asp-validation-for="NewIngredient.Id" class="text-danger"></span>
				</div>

				<div class="col-md-2">
					<input asp-for="NewIngredient.Quantity" class="form-control" placeholder="Quantity" />
					<span asp-validation-for="NewIngredient.Quantity" class="text-danger"></span>
				</div>

				<div class="col-md-2">
					<select asp-for="NewIngredient.MeasurementUnit"
							asp-items="Html.GetEnumSelectList<MeasurementUnit>()"
							class="form-select"></select>
				</div>

				<div class="col-md-3">
					<input asp-for="NewIngredient.Note" class="form-control" placeholder="Note (e.g. finely chopped)" />
					<span asp-validation-for="NewIngredient.Note" class="text-danger"></span>
				</div>

				<div class="col-md-2 d-grid">
					<button type="submit" class="btn btn-success">Add ingredient</button>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
