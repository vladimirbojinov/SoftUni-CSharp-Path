@using CookBookApp.Web.ViewModels.Recipe

@model RecipeDetailsViewModel

@{
	ViewData["Title"] = Model.Name;
}

<div class="card shadow-sm mb-4 overflow-hidden">
	<div class="row g-0">

		<div class="col-md-5">
			<div class="ratio ratio-4x3">
				<img src="@Model.ImageUrl" class="object-fit-cover" alt="@Model.Name" />
			</div>
		</div>

		<div class="col-md-7 d-flex">
			<div class="card-body p-4 d-flex flex-column w-100">
				<div>
					<div class="d-flex flex-wrap gap-2 mb-2">
						<span class="badge text-bg-primary">@Model.CategoryName</span>
						<span class="badge text-bg-secondary">@Model.Ingredients.Count ingredients</span>
						@if (Model.TotalTime > 0 && Model.TotalTime <= 30)
						{
							<span class="badge text-bg-success">Quick</span>
						}
					</div>
					<h1 class="display-6 fw-bold mb-0">@Model.Name</h1>
				</div>
				<div class="row row-cols-2 row-cols-lg-4 g-3 text-center my-4 my-md-auto">
					<div class="col">
						<div class="bg-primary-subtle rounded p-3 h-100">
							<div class="text-muted small">Prep</div>
							<div class="fs-4 fw-bold">@Model.PrepTime</div>
						</div>
					</div>
					<div class="col">
						<div class="bg-primary-subtle rounded p-3 h-100">
							<div class="text-muted small">Cook</div>
							<div class="fs-4 fw-bold">@Model.CookTime</div>
						</div>
					</div>
					<div class="col">
						<div class="bg-primary-subtle rounded p-3 h-100">
							<div class="text-muted small">Total</div>
							<div class="fs-4 fw-bold">@Model.TotalTime</div>
						</div>
					</div>
					<div class="col">
						<div class="bg-primary-subtle rounded p-3 h-100">
							<div class="text-muted small">Servings</div>
							<div class="fs-4 fw-bold">@Model.Servings</div>
						</div>
					</div>
				</div>
				<div class="d-flex flex-wrap gap-2">
					<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
					<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
					<a asp-action="Index" class="btn btn-outline-secondary ms-md-auto">Back to list</a>
				</div>

			</div>
		</div>

	</div>
</div>

<div class="row g-4">
	<div class="col-md-5">
		<div class="card shadow-sm">
			<div class="card-header">
				<h2 class="h5 mb-0">Ingredients</h2>
			</div>

			@if (Model.Ingredients.Any())
			{
				<ul class="list-group list-group-flush">
					@foreach (var item in Model.Ingredients)
					{
						<li class="list-group-item">
							<span class="fw-semibold">@item.Quantity @item.MeasurementUnit</span>
							@item.Name, <span class="text-muted fst-italic">@item.Note</span>
						</li>
					}
				</ul>
			}
			else
			{
				<div class="card-body text-muted">No ingredients added yet.</div>
			}
		</div>
	</div>

	<div class="col-md-7">
		<div class="card shadow-sm">
			<div class="card-header">
				<h2 class="h5 mb-0">Instructions</h2>
			</div>
			<div class="card-body">
				@foreach (var text in Model.Instructions.Split("\n"))
				{
					<p class="mb-0">@text</p>
				}
			</div>
		</div>
	</div>
</div>
