@using CookBookApp.Web.ViewModels.Recipe

@model RecipeIndexViewModel

@{
    ViewData["Title"] = "Delete Recipe";
}

<div class="container my-4">
    <div class="alert alert-danger">
        <h4 class="alert-heading">Are you sure?</h4>
        <p class="mb-0">
            Do you really want to delete <strong>@Model.Name</strong>? This cannot be undone.
        </p>
    </div>

    <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>